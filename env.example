# Auth0 SPA (browser) — create a Single Page Application in the Auth0 Dashboard.
# Create an API with an identifier (audience) your backend validates.

NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your_spa_client_id
# Same origin you run the app on (no trailing slash). Must match Allowed Callback / Logout URLs.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Optional — API identifier from Auth0 → APIs; enables access tokens for your backend.
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.yourapp.com

# Backend host (no trailing slash). The app calls /api/backend/... on the Next server, which proxies
# here — so the browser never cross-origin requests :8080 (avoids CORS during local dev).
# Example: http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# Optional — override proxy target on the server only (defaults to NEXT_PUBLIC_BACKEND_URL).
# BACKEND_PROXY_ORIGIN=http://localhost:8080

# Optional — entries only; defaults to NEXT_PUBLIC_BACKEND_URL when unset.
# NEXT_PUBLIC_API_BASE_URL=https://api.yourapp.com

# Entries resource path on the backend (no leading slash). Proxied as /api/backend/<path>
# NEXT_PUBLIC_ENTRIES_PATH=api/v1/entries
